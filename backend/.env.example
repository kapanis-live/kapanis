MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=kriptokapi
# Long random string; signs login tokens
JWT_SECRET=
# Must match BOT_API_KEY in the bot's .env
BOT_API_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3000
# 1 = load demo data on startup (real data comes from the bot)
SEED_MOCK=0
# 1 only when running behind a trusted reverse proxy that appends X-Forwarded-For
# TRUST_PROXY=0
