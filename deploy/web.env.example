# Copy to .env (this PC) or enter in the server's Environment Variables (Render dashboard / deploy/web.env).
# Never commit real values. Public in the browser: only the Clerk publishable key.

# --- Database: the bot and the panel share one MongoDB (Atlas in the cloud) ---
# Atlas: mongodb+srv://kapanis_app:<URL-ENCODED-PASSWORD>@cluster0.xxxxxx.mongodb.net/?appName=Cluster0
# A password with special characters (^ $ # ; < > @ : / ...) must be URL encoded:
#   python -c "import urllib.parse; print(urllib.parse.quote(input('şifre: '), safe=''))"
# This PC keeps its local MongoDB: MONGO_URL=mongodb://127.0.0.1:27017 (MONGO_URL wins over STATE_MONGO_URL)
STATE_MONGO_URL=
STATE_DB_NAME=kapanis

# Long random string; signs local (legacy) login tokens: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Must match the bot's BOT_API_KEY. Machine-to-machine only, separate from user sessions.
BOT_API_KEY=

# --- Sign-in ---
# clerk = Google / e-mail + password + e-mail code (the site) · legacy = this PC's single admin password · both
AUTH_MODE=clerk
# Clerk dashboard -> API keys. The publishable key is safe to show; the secret key is not.
# Issuer and JWKS address are derived from the publishable key (override with CLERK_ISSUER / CLERK_JWKS_URL).
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Sites allowed to use a Clerk session (comma separated), e.g. https://kapanis.app
CLERK_AUTHORIZED_PARTIES=
# The bot owner's account: sees the bot's portfolio, signals, alarms. Everyone else is a user.
OWNER_EMAIL=
# AI analyses per non-owner user per day, on the owner's keys (DeepSeek costs money). 0 = users must add their own key
USER_DAILY_ANALYSES=5
# ... per user per day when they entered their own API key (Hesap page)
USER_KEY_DAILY_ANALYSES=50
# All users together per day on the owner's keys (the shared, owner-paid capacity)
GLOBAL_DAILY_ANALYSES=100
# Encrypts users' own AI API keys in the database. Keep it secret and never change it casually
# (saved keys become unreadable). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_ENCRYPTION_KEY=
# Shown on the privacy page as the contact for data requests (optional)
CONTACT_EMAIL=
# Telegram bot username without @ (for the "link Telegram" button)
TELEGRAM_BOT_USERNAME=

# legacy mode only (this PC): the owner's local account; the password hash is stored in MongoDB
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

CORS_ORIGINS=https://kapanis.app
# 1 behind a reverse proxy that appends X-Forwarded-For (Render, Caddy)
TRUST_PROXY=1
# 1 = load demo data on startup (real data comes from the bot)
SEED_MOCK=0

# Rate limits (defaults shown): /api requests per IP per minute, chart loads per user per minute,
# open live-update connections per user. Over the limit the API answers 429.
# RATE_IP_PER_MINUTE=180
# RATE_CHART_PER_MINUTE=40
# RATE_MAX_STREAMS=3

# --- Kripto Danışman V2 (admin only: /admin/advisor) -------------------------------------------------
# Who may open it: the owner whose VERIFIED e-mail is on this list (comma separated). Empty = the owner alone.
# The check is made on the server from the session; nothing the browser sends takes part in it.
ADMIN_EMAILS=
# Three independent AI analyses: the TECHNICAL, RISK and REGIME roles (any OpenAI-compatible endpoint). By default all
# three run on the same DeepSeek model: three roles, not three models. Without a key a role is NOT_CONFIGURED and no
# buy plan is released (DEGRADED_CONSENSUS). Keys stay on the server and never reach the browser.
# Providers: deepseek (DEEPSEEK_API_KEY) · nvidia (NVIDIA_API_KEY, or KIMI_API_KEY / GLM_API_KEY) · openai · custom
DEEPSEEK_API_KEY=
# NVIDIA_API_KEY=
# TECHNICAL_AI_PROVIDER=deepseek
# TECHNICAL_AI_MODEL=deepseek-flash
# RISK_AI_PROVIDER=deepseek
# RISK_AI_MODEL=deepseek-flash
# REGIME_AI_PROVIDER=deepseek
# REGIME_AI_MODEL=deepseek-flash
# Seconds one attempt of one analyst may take (one retry after a timeout or an answer that is not valid JSON), and the
# hard limit for the three together (they run in parallel). Past it: FAILED, DEGRADED_CONSENSUS, no buy.
# ADVISOR_AI_TIMEOUT_SECONDS=60
# ADVISOR_AI_TOTAL_TIMEOUT_SECONDS=100
# OpenBB (macro, calendar, cross-asset) lives in its own Python, because it needs a newer FastAPI than this backend:
#   python -m venv /opt/openbb && /opt/openbb/bin/pip install openbb     (about 1 GB)
# Empty = macro is UNAVAILABLE and the technical advisor works without it. NOT enabled in production yet: see
# deploy/OPENBB_STAGING.md. Either a Python that has openbb (a process per read) or a worker service on the internal network.
# OPENBB_PYTHON=/opt/openbb/bin/python
# OPENBB_URL=http://openbb:8010
# No calendar provider rates an event's importance; the advisor does not guess. Events whose name contains one of
# these words count as high impact (caution 60 min before, no new entry 15 min before). Empty = impact unknown.
# ADVISOR_MACRO_HIGH_IMPACT_KEYWORDS=cpi,nonfarm,fomc,interest rate decision,pce
# Any threshold of danisman_v2/config.py can be overridden as ADVISOR_<NAME>, e.g.
# ADVISOR_RISK_PER_TRADE_PCT=0.35
# ADVISOR_MAX_NEW_POSITION_PCT=3.0
# ADVISOR_MIN_STOP_ATR15=1.50
# Exposure limits are CONFIGURED_POLICY (your own preference, not a test result). Defaults are placeholders:
# ADVISOR_MAX_TOTAL_CRYPTO_EXPOSURE_PCT=60
# ADVISOR_MAX_ALT_EXPOSURE_PCT=30
# ADVISOR_MAX_MEME_EXPOSURE_PCT=5
# ADVISOR_MAX_CORRELATED_EXPOSURE_PCT=25
