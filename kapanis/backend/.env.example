# Copy to .env (this PC) or enter in the server's Environment Variables (Render dashboard / deploy/web.env).
# Never commit real values. Public in the browser: only the Clerk publishable key.

# --- Database: the bot and the panel share one MongoDB (Atlas in the cloud) ---
# Atlas: mongodb+srv://kapanis_app:<URL-ENCODED-PASSWORD>@cluster0.xxxxxx.mongodb.net/?appName=Cluster0
# A password with special characters (^ $ # ; < > @ : / ...) must be URL encoded:
#   python -c "import urllib.parse; print(urllib.parse.quote(input('şifre: '), safe=''))"
# This PC keeps its local MongoDB: MONGO_URL=mongodb://127.0.0.1:27017 (MONGO_URL wins over STATE_MONGO_URL)
STATE_MONGO_URL=
STATE_DB_NAME=kapanis

# Long random string; signs local (legacy) login tokens: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Must match the bot's BOT_API_KEY. Machine-to-machine only, separate from user sessions.
BOT_API_KEY=

# --- Sign-in ---
# clerk = Google / e-mail + password + e-mail code (the site) · legacy = this PC's single admin password · both
AUTH_MODE=clerk
# Clerk dashboard -> API keys. The publishable key is safe to show; the secret key is not.
# Issuer and JWKS address are derived from the publishable key (override with CLERK_ISSUER / CLERK_JWKS_URL).
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Sites allowed to use a Clerk session (comma separated), e.g. https://kapanis.app
CLERK_AUTHORIZED_PARTIES=
# The bot owner's account: sees the bot's portfolio, signals, alarms. Everyone else is a user.
OWNER_EMAIL=
# AI analyses per non-owner user per day, on the owner's keys (DeepSeek costs money). 0 = users must add their own key
USER_DAILY_ANALYSES=5
# ... per user per day when they entered their own API key (Hesap page)
USER_KEY_DAILY_ANALYSES=50
# All users together per day on the owner's keys (the shared, owner-paid capacity)
GLOBAL_DAILY_ANALYSES=100
# Encrypts users' own AI API keys in the database. Keep it secret and never change it casually
# (saved keys become unreadable). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_ENCRYPTION_KEY=
# Shown on the privacy page as the contact for data requests (optional)
CONTACT_EMAIL=
# Telegram bot username without @ (for the "link Telegram" button)
TELEGRAM_BOT_USERNAME=

# legacy mode only (this PC): the owner's local account; the password hash is stored in MongoDB
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

CORS_ORIGINS=https://kapanis.app
# 1 behind a reverse proxy that appends X-Forwarded-For (Render, Caddy)
TRUST_PROXY=1
# 1 = load demo data on startup (real data comes from the bot)
SEED_MOCK=0

# Rate limits (defaults shown): /api requests per IP per minute, chart loads per user per minute,
# open live-update connections per user. Over the limit the API answers 429.
# RATE_IP_PER_MINUTE=180
# RATE_CHART_PER_MINUTE=40
# RATE_MAX_STREAMS=3
