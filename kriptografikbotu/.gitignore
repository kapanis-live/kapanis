# Secrets: never commit (API keys, Telegram token)
.env
.env.*
!.env.example

# Environments and caches
.venv/
.uv-python/
.uv-cache/
__pycache__/
*.pyc

# Logs can contain request URLs with the Telegram bot token
*.log
*.log.*
data/*.log*

# Large / local-only
*.zip
ornek

# Personal data (portfolio, decisions, chat history, settings): stays on this PC and in MongoDB Atlas,
# never in git. Migration: scripts/import_data_to_atlas.py
data/

# Daily database backups (every user's data): stay on the server, never in git
backups/

# research kline cache
research/kl/
research/*.json
research/*.log

# advisor paper log (research snapshots of /danis and /firsat runs)
research/advisor_paper.jsonl

# written by the deploy script before the image is built (the commit that is running)
.git_commit
