# Copy to .env (this PC) or enter as environment variables on Heroku/Render. Never commit real values.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=kriptokapi
# Long random string; signs the local (legacy) login tokens
JWT_SECRET=
# Must match BOT_API_KEY in the bot's environment. Separate from user sessions.
BOT_API_KEY=

# Sign-in: legacy = this PC's single admin password · clerk = Google / e-mail + code (cloud) · both
AUTH_MODE=legacy
# legacy mode: the owner's local account (password hash is stored in this MongoDB)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# clerk mode (Clerk dashboard -> API keys). The publishable key is public; the secret key is not.
# CLERK_PUBLISHABLE_KEY=pk_live_...
# CLERK_SECRET_KEY=sk_live_...
# Clerk dashboard -> API keys -> "Frontend API URL" + /.well-known/jwks.json, and the same URL as issuer
# CLERK_JWKS_URL=https://clerk.kapanis.app/.well-known/jwks.json
# CLERK_ISSUER=https://clerk.kapanis.app
# Sites allowed to use a session (comma separated)
# CLERK_AUTHORIZED_PARTIES=https://kapanis.app
# Whose account is the bot owner (sees the bot's portfolio, signals, alarms). Everyone else is a user.
# OWNER_EMAIL=valenciaennerman@gmail.com
# AI analyses a non-owner user may request per day (DeepSeek costs money)
# USER_DAILY_ANALYSES=5
# Telegram bot username (without @) for the "link Telegram" button
# TELEGRAM_BOT_USERNAME=

CORS_ORIGINS=http://localhost:3000
# 1 = load demo data on startup (real data comes from the bot)
SEED_MOCK=0
# 1 only when running behind a trusted reverse proxy that appends X-Forwarded-For (Heroku, Render, Caddy)
# TRUST_PROXY=0
