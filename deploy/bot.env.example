# Copy to .env (this PC) or enter as environment variables on Heroku/Render. Never commit real values.
TELEGRAM_BOT_TOKEN=
DEEPSEEK_API_KEY=
# Kimi K3 / GLM 5.3 via NVIDIA (free credits). One key for both, or separate KIMI_API_KEY / GLM_API_KEY.
NVIDIA_API_KEY=
TIINGO_API_KEY=
# Send /start to the bot once; it replies with your chat id. Owner-only commands and personal alerts go here.
ALLOWED_CHAT_ID=
FRED_API_KEY=
BLS_API_KEY=
# CFTC Public Reporting (Socrata) app token
CFTC_APP_TOKEN=
# SEC EDGAR asks for a contact, e.g. "Kapanis your@email.com"
SEC_USER_AGENT=
# Optional: TCMB EVDS for CPI based returns
# EVDS_API_KEY=

# Kapanış web panel sync. Empty WEB_URL = sync disabled. BOT_API_KEY must match the panel backend's.
# This PC: http://localhost:8001 · docker compose: http://web:8001 (set by docker-compose.yml; bot
# endpoints are refused for anything that came through the public site). PUBLIC_URL is only for links.
WEB_URL=http://localhost:8001
PUBLIC_URL=https://kapanis.live
BOT_API_KEY=

# Cloud worker only: keep data/ (portfolio, alarms, decisions, settings) in MongoDB Atlas, because the
# cloud disk is wiped on every restart. Leave empty in this PC's .env (the local bot keeps using data/).
# On this PC put it in .env.atlas instead; scripts/import_data_to_atlas.py reads it from there.
# Password with special characters must be URL encoded (see kapanis/backend/.env.example).
# STATE_MONGO_URL=mongodb+srv://kapanis_app:<URL-ENCODED-PASSWORD>@cluster0.xxxxxx.mongodb.net/?appName=Cluster0
# STATE_DB_NAME=kapanis

# USD/TRY rate for /maliyet
# USD_TRY=48.9
# OLLAMA_URL=http://localhost:11434

# Daily database backup at 03:30 (only with STATE_MONGO_URL). Restore: scripts/restore_backup.py
# BACKUP_DIR=/app/kriptografikbotu/backups
# BACKUP_KEEP=14
