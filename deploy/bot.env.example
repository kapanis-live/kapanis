# Copy to .env (this PC) or enter as environment variables on Heroku/Render. Never commit real values.
TELEGRAM_BOT_TOKEN=
DEEPSEEK_API_KEY=
# Kimi K3 / GLM 5.3 via NVIDIA (free credits). One key for both, or separate KIMI_API_KEY / GLM_API_KEY.
NVIDIA_API_KEY=
TIINGO_API_KEY=
# Send /start to the bot once; it replies with your chat id. Owner-only commands and personal alerts go here.
ALLOWED_CHAT_ID=
FRED_API_KEY=
BLS_API_KEY=
# CFTC Public Reporting (Socrata) app token
CFTC_APP_TOKEN=
# SEC EDGAR asks for a contact, e.g. "Kapanis your@email.com"
SEC_USER_AGENT=
# Optional: TCMB EVDS for CPI based returns
# EVDS_API_KEY=

# Kapanış web panel sync. Empty WEB_URL = sync disabled. BOT_API_KEY must match the panel backend's.
# This PC: http://localhost:8001 · cloud: the web service URL, e.g. https://kapanis.app
WEB_URL=http://localhost:8001
BOT_API_KEY=

# Cloud only: keep data/ (portfolio, alarms, decisions, settings) in MongoDB Atlas, because the cloud
# disk is wiped on every restart. Leave empty on this PC.
# STATE_MONGO_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# STATE_DB_NAME=kapanis

# USD/TRY rate for /maliyet
# USD_TRY=48.9
# OLLAMA_URL=http://localhost:11434
